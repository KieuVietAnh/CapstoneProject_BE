# Messenger integration
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_ACCOUNT_LINK_BASE_URL=https://urbanservice.me/messenger/link
MESSENGER_ACCOUNT_LINK_TOKEN_MINUTES=10
MESSENGER_GRAPH_API_VERSION=v25.0
MESSENGER_ALLOWED_MEDIA_HOST_SUFFIXES=fbcdn.net,fbsbx.com
MESSENGER_MAX_IMAGES_PER_FEEDBACK=5
MESSENGER_MAX_IMAGE_BYTES=5242880

# Cloudinary is required when Messenger evidence images are enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI review and duplicate Report -> Incident matching
AI_REVIEW_WORKER_ENABLED=true
AI_DUPLICATE_NEARBY_RADIUS_METERS=200
AI_DUPLICATE_MAX_CANDIDATES=10
AI_DUPLICATE_LOOKBACK_DAYS=7

# Zalo OA integration
ZALO_ENABLED=false
ZALO_APP_ID=
ZALO_APP_SECRET_KEY=
ZALO_OA_ID=
ZALO_OA_SECRET_KEY=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_ACCESS_TOKEN_EXPIRES_AT_UTC=
# Generate with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
ZALO_TOKEN_ENCRYPTION_KEY=
ZALO_SUBMISSION_USER_ID=
ZALO_ALLOWED_MEDIA_HOST_SUFFIXES=zdn.vn,zadn.vn,zalo.me,zaloapp.com
ZALO_MAX_IMAGES_PER_FEEDBACK=5
ZALO_MAX_IMAGE_BYTES=5242880

# Apply EF Core migrations when the container starts.
DATABASE_MIGRATE_ON_STARTUP=true

# Firebase Phone Auth: dán nguyên nội dung file service account JSON tải từ
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Backend dùng nó để xác minh ID token của luồng OTP, không dùng để gửi SMS.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Trần SMS OTP mỗi ngày cho toàn hệ thống. Mỗi tin là chi phí thật.
PHONE_OTP_DAILY_LIMIT=10

# Số test khai trong Firebase Console, ngăn cách bằng dấu phẩy. Chúng không phát
# SMS thật nên không tính vào hạn mức ở trên. Danh sách này phải khớp với Console.
PHONE_OTP_TEST_NUMBERS=+84909999999,+84987654321,+84901234567,+84999999999

# Số phản ánh tối đa một tài khoản gửi từ web mỗi ngày.
FEEDBACK_DAILY_PER_USER=3
